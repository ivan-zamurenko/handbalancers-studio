# Copy values into your process environment explicitly; no automatic .env loading.
# Allowed APP_ENV: local-dev, local-test, test, staging, production.
APP_ENV=local-dev
PUBLIC_ORIGIN=http://127.0.0.1:8000
# Staging/production require HTTPS PUBLIC_ORIGIN and a nonblank encryption key.
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=
AUTH_DATABASE_URL=
WORKER_DATABASE_URL=
OAUTH_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# OAuth through Supabase. Provider secrets belong in Supabase, not browser code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AUTH_EMAIL_ENABLED=false
OAUTH_GOOGLE_ENABLED=false
# When email auth or OAuth is enabled TOKEN_ENCRYPTION_KEY must be 32 random bytes in Base64.
# AUTH_DATABASE_URL must use a dedicated login with studio_auth_runtime membership.
# Staging/production additionally require sslmode=verify-full and a trusted CA.
# Supply sslrootcert=/absolute/path/to/ca.crt (or a configured libpq trust store).
# Fixed 60-second application auth budgets; values 1..10 only (no disable switch).
AUTH_CLIENT_ATTEMPTS_PER_MINUTE=10
AUTH_ACCOUNT_ATTEMPTS_PER_MINUTE=10
# Signup/resend/recovery additionally allow at most one attempt per email per minute.
