server {
    listen 80 default_server;
    server_name _;
    error_log /dev/null;
    return 444;
}

server {
    listen 80;
    server_name ${STUDIO_HOST};
    # Request-context errors can otherwise include an OAuth query string.
    error_log /dev/null;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location = /_proxy/live {
        access_log off;
        return 200 'proxy ready\n';
    }

    # The application never becomes available over plain HTTP during bootstrap.
    location / {
        return 503 'HTTPS setup in progress\n';
    }
}
