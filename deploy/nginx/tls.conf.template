server {
    listen 80 default_server;
    server_name _;
    error_log /dev/null;
    return 444;
}

server {
    listen 80;
    server_name ${STUDIO_HOST};
    error_log /dev/null;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location = /_proxy/live {
        access_log off;
        return 200 'proxy ready\n';
    }

    location / {
        return 308 https://${STUDIO_HOST}$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    error_log /dev/null;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${STUDIO_HOST};
    # Keep status-only access logs; request error logs may contain OAuth codes.
    error_log /dev/null;

    ssl_certificate /etc/letsencrypt/live/${STUDIO_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${STUDIO_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security 'max-age=31536000' always;

    location = /api/session {
        limit_req zone=studio_session burst=5 nodelay;
        include /opt/studio/proxy.inc;
    }

    location ^~ /auth/ {
        limit_req zone=studio_auth burst=5 nodelay;
        include /opt/studio/proxy.inc;
    }

    location = /api/webhooks/stripe {
        # Match the backend's larger signed-event allowance.
        client_max_body_size 1m;
        include /opt/studio/proxy.inc;
    }

    location / {
        include /opt/studio/proxy.inc;
    }
}
