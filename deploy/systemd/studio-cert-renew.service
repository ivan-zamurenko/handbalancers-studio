[Unit]
Description=Renew Handbalancer's Studio TLS certificates and reload nginx
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/handbalancers-studio
ExecStart=/bin/sh /opt/handbalancers-studio/deploy/renew-certificates.sh /opt/handbalancers-studio/.env.compose.production
UMask=0077
