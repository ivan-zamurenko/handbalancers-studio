{
  "name": "handbalancers-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run build && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "vite": "8.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.2",
    "oxlint": "1.82.0",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/node": "24.13.3",
    "prettier": "3.9.6"
  }
}
