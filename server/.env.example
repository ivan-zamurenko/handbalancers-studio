# Examples contain no working secrets. deploy/create_env.py creates a private
# Compose environment without printing its generated values or replacing files.
APP_ENV=development
LOCAL_PREVIEW=false
BASE_URL=http://127.0.0.1:8000
SESSION_SECRET=

# Compose connects to the private hostname db. Native development uses its own
# PostgreSQL host/port. Keep the postgresql+psycopg URL scheme in both cases.
DATABASE_URL=
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
APP_DATABASE_NAME=studio

# Production uses exactly one public DNS hostname, without scheme, port or path.
STUDIO_HOST=
ACME_EMAIL=

# Missing provider credentials keep that provider unavailable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Apple requires an HTTPS return URL and a valid, unexpired client-secret JWT.
# Stripe must use one consistent test/live mode and the four matching Price IDs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_PLUS=
